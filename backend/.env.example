APP_ENV=development
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/comphub
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
JWT_EXPIRE_MINUTES=60
REDIS_URL=redis://localhost:6379/0
MODEL_PATH=ml/models/xgboost_salary_model.pkl
SHAP_EXPLAINER_PATH=ml/models/shap_explainer.pkl
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FIREBASE_PROJECT_ID=your-firebase-project-id
# Store the downloaded Firebase Admin service account JSON outside the repo; never commit this private key.
FIREBASE_SERVICE_ACCOUNT_PATH=C:/secure/path/firebase-service-account.json
# Explicitly map verified Firebase emails to existing users; role is read from that user.
FIREBASE_AUTH_EMAIL_MAP={"your.email@gmail.com":"employee"}
DEMO_ADMIN_PASSWORD=AdminDemo123!
DEMO_MANAGER_PASSWORD=ManagerDemo123!
DEMO_EMPLOYEE_PASSWORD=EmployeeDemo123!
